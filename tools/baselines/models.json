{
  "protocol_id": "sintel-final-train1041-center416-raw-v1",
  "description": "1041 pairs, Final, center rows 10:426, all pixels, source-pixel EPE; no GT/prediction clipping. Historical GT +/-50 is secondary only.",
  "models": [
    {
      "run": "raft-things",
      "name": "RAFT",
      "adapter": "raft",
      "training": "Chairs + Things",
      "sintel_finetuned": false,
      "source": "https://github.com/princeton-vl/RAFT",
      "weight": "raft-things.pth",
      "input": "416x1024 RGB",
      "status": "eligible"
    },
    {
      "run": "spynet-chairs",
      "name": "SPyNet",
      "adapter": "spynet",
      "training": "Chairs; chairs-final variant",
      "sintel_finetuned": false,
      "source": "https://github.com/sniklaus/pytorch-spynet",
      "weight": "network-chairs-final.pytorch",
      "input": "416x1024",
      "status": "eligible",
      "note": "Unofficial PyTorch reimplementation linked by original authors; not original Lua runtime."
    },
    {
      "run": "pwc-things",
      "name": "PWC-Net",
      "adapter": "pwc",
      "training": "FlyingThings3D per NVlabs PyTorch README",
      "sintel_finetuned": false,
      "source": "https://github.com/NVlabs/PWC-Net",
      "weight": "pwc_net_chairs.pth.tar",
      "input": "416x1024 -> 448x1024 internally",
      "status": "eligible",
      "note": "Misleading chairs filename; author README identifies Things. Pure Torch correlation adaptation and old align_corners=True semantics."
    },
    {
      "run": "edge-full",
      "name": "EdgeFlowNet Full",
      "adapter": "edge",
      "training": "FC2/FT3D per paper; checkpoint training log not published",
      "sintel_finetuned": false,
      "source": "https://github.com/pearwpi/EdgeFlowNet",
      "weight": "checkpoints/best.ckpt",
      "input": "416x1024 BGR",
      "status": "eligible"
    },
    {
      "run": "edge-chunks",
      "name": "EdgeFlowNet four chunks",
      "adapter": "edge-chunks",
      "training": "Same public checkpoint as Full",
      "sintel_finetuned": false,
      "source": "https://github.com/pearwpi/EdgeFlowNet",
      "weight": "checkpoints/best.ckpt",
      "input": "4 nonoverlapping 208x512 chunks",
      "status": "eligible",
      "note": "Our explicit high-resolution four-tile protocol; not paper's four 176x240 deployment tiles; no seam smoothing."
    },
    {
      "run": "nano-native-provisional",
      "name": "NanoFlowNet",
      "adapter": "nano",
      "training": "FC2 then FT3D per paper; exact public checkpoint history not published",
      "sintel_finetuned": false,
      "source": "https://github.com/tudelft/nanoflownet",
      "weight": "nanoflownet-cnns/pretrained_models/nanoflownet/nanoflownet.h5",
      "input": "112x160 grayscale; output interpolated to 416x1024",
      "status": "provisional",
      "note": "公开loader只改变NPY光流的空间尺寸，没有缩放向量；但NPY转换来源缺失。当前按源图像素单位计分，确认前不进入正式名次。"
    },
    {
      "run": "spynet-sintel",
      "name": "SPyNet (Sintel fine-tuned)",
      "adapter": "spynet",
      "training": "Sintel fine-tuned",
      "sintel_finetuned": true,
      "source": "https://github.com/sniklaus/pytorch-spynet",
      "weight": "network-sintel-final.pytorch",
      "input": "416x1024",
      "status": "in_sample_reference"
    },
    {
      "run": "pwc-sintel",
      "name": "PWC-Net (Sintel fine-tuned)",
      "adapter": "pwc",
      "training": "Sintel fine-tuned",
      "sintel_finetuned": true,
      "source": "https://github.com/NVlabs/PWC-Net",
      "weight": "pwc_net.pth.tar",
      "input": "416x1024 -> 448x1024 internally",
      "status": "in_sample_reference"
    },
    {
      "run": "raft-sintel",
      "name": "RAFT (Sintel fine-tuned)",
      "adapter": "raft",
      "training": "Sintel-stage mixed data fine-tuning",
      "sintel_finetuned": true,
      "source": "https://github.com/princeton-vl/RAFT",
      "weight": "raft-sintel.pth",
      "input": "416x1024 RGB",
      "status": "in_sample_reference"
    },
    {
      "run": "ajna",
      "name": "Ajna",
      "adapter": null,
      "training": "FC2 400 epochs + FT3D 50 per official wiki",
      "sintel_finetuned": false,
      "source": "https://github.com/prgumd/ajna/wiki/RunningCode",
      "weight": "449.ckpt (unavailable)",
      "input": "unverified",
      "status": "blocked",
      "note": "官方Drive链接显示文件不存在，wiki历史仍是同一链接。其他旧架构实验的权重不能替代论文权重。"
    }
  ]
}
