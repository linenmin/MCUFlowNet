# Copy to `.env` and fill in your own keys. `.env` is gitignored — never commit real keys.
# Required only for the L3 LLM-in-the-loop search (Chapter 6). Training/eval do not need these.

# Anthropic Claude (used for the scientist / supervisor / warm-start agents)
ANTHROPIC_API_KEY=

# OpenAI (optional — only if you select an "openai/..." model in the search config)
OPENAI_API_KEY=
